# ---------------------------------------------------------------------------
# WebSite_OfMine — 行尾与文件类型规范
# 目标：仓库内文本文件统一以 LF 存储，二进制文件不做任何转换。
# ---------------------------------------------------------------------------

# 由 Git 自动判断是否为文本文件
* text=auto

# 源码与文档：仓库内统一 LF
*.py         text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.toml       text eol=lf
*.cfg        text eol=lf
*.ini        text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Windows 脚本保留 CRLF
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# 二进制文件：不做行尾转换
*.db         binary
*.xlsx       binary
*.png        binary
*.jpg        binary
*.ico        binary
