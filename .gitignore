# ---------------------------------------------------------------------------
# WebSite_OfMine — Git 忽略规则
# 说明：本项目为个人使用的本地工具，数据库与导出结果属于本地数据，不入库。
# ---------------------------------------------------------------------------

# --- Python 字节码与构建产物 ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- 虚拟环境 ---
.venv/
venv/
env/
ENV/

# --- 本地数据（含个人网址记录，禁止入库）---
wm/websites.db
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- 导出产物 ---
*.xlsx
*.csv

# --- 编辑器与 IDE ---
.idea/
.vscode/
*.swp
*.swo

# --- 操作系统 ---
.DS_Store
Thumbs.db
desktop.ini
